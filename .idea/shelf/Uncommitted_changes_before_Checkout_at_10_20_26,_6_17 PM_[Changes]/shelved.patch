<+>package kh.edu.istad.platform.customer.persistence.adapter;\n\nimport kh.edu.istad.common.domain.valueobject.CustomerId;\nimport kh.edu.istad.platform.customer.domain.dto.CustomerFilter;\nimport kh.edu.istad.platform.customer.domain.dto.CustomerStatistic;\nimport kh.edu.istad.platform.customer.domain.dto.CustomerStatusCount;\nimport kh.edu.istad.platform.customer.domain.dto.CustomerSummary;\nimport kh.edu.istad.platform.customer.domain.entity.Customer;\nimport kh.edu.istad.platform.customer.domain.exception.CustomerNotFoundException;\nimport kh.edu.istad.platform.customer.domain.port.out.CustomerRepository;\nimport kh.edu.istad.platform.customer.persistence.Document.CustomerDocument;\nimport kh.edu.istad.platform.customer.persistence.mapper.CustomerPersistenceMapper;\nimport kh.edu.istad.platform.customer.persistence.repository.CustomerMongoRepository;\nimport lombok.RequiredArgsConstructor;\nimport org.bson.Document;\nimport org.springframework.stereotype.Repository;\nimport reactor.core.publisher.Flux;\nimport reactor.core.publisher.Mono;\n\n@Repository\n@RequiredArgsConstructor\npublic class CustomerReactiveRepositoryAdapter implements CustomerRepository {\n\n    private final CustomerMongoRepository customerMongoRepository;\n    private final CustomerPersistenceMapper customerPersistenceMapper;\n\n    @Override\n    public Mono<Customer> save(Customer customer) {\n        CustomerDocument customerDocument = customerPersistenceMapper.toDocument(customer);\n        Mono<CustomerDocument> result = customerMongoRepository.save(customerDocument);\n        return result.map(customerPersistenceMapper::toDomain);\n    }\n\n    @Override\n    public Flux<Customer> findAll() {\n        return customerMongoRepository.findAll().map(customerPersistenceMapper::toDomain);\n    }\n\n    @Override\n    public Mono<Customer> findById(CustomerId id) {\n        return customerMongoRepository.findById(id.id().toString()).map(customerPersistenceMapper::toDomain);\n    }\n\n    @Override\n    public Mono<Void> deleteById(CustomerId id) {\n        return customerMongoRepository.deleteById(id.id().toString());\n    }\n\n    @Override\n    public Mono<Customer> findByUsername(String username) {\n        return customerMongoRepository.findByUsername(username).map(customerPersistenceMapper::toDomain);\n    }\n\n    @Override\n    public Mono<Customer> update(Customer customer) {\n\n        var customerId = customer.getId().id();\n        return customerMongoRepository.findById(customerId.toString())\n                .switchIfEmpty(\n                        Mono.error(new CustomerNotFoundException(customerId))\n                )\n                .flatMap(existingDocument -> {\n                    customerPersistenceMapper.updateDocument(\n                            customer,\n                            existingDocument\n                    );\n\n                    return customerMongoRepository.save(existingDocument)\n                            .map(customerPersistenceMapper::toDomain);\n                })\n                .map(customerPersistenceMapper::toDomain);\n    }\n\n}\n
